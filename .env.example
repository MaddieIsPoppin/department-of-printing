# Public canonical origin (also enforced by the enquiry API)
SITE_URL=http://localhost:3000
# Enable only after business details, policies and enquiry delivery are verified.
SITE_INDEXABLE=false
# Optional public contact channels. International digits only for WhatsApp.
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=
# Server-only Resend credentials and verified sender/recipient.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
# Absolute PRIVATE durable-volume path, outside public/. Required for submissions.
ENQUIRY_DATA_DIR=
# Generate a long random secret. Used to hash rate-limit identities.
ENQUIRY_HASH_SECRET=
# Optional trusted proxy-sanitised client-IP header. Empty = global limit.
ENQUIRY_IP_HEADER=
